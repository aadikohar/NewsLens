{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{newslens.db,seed_data.json.gz,api/seed_data.json.gz,static/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route__=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__route__=/$1"
    }
  ]
}
