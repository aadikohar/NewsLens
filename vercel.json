{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{newslens.db,seed_data.json.gz}"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
